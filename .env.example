# =============================================================================
# Threadback — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in values for your local environment.
# NEVER commit .env to version control.
# NEVER put real credentials in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Threadback
APP_VERSION=0.1.0
APP_ENV=development        # development | production
DEBUG=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# M3 — Database (PostgreSQL)
# Add when implementing Thread Domain + Database milestone.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://threadback:password@localhost:5432/threadback_dev

# ---------------------------------------------------------------------------
# M8 — Threadback Agent & Model Provider
# ---------------------------------------------------------------------------
THREADBACK_AGENT_PROVIDER=mock       # mock | bedrock
THREADBACK_MCP_URL=http://localhost:8000/mcp

# ---------------------------------------------------------------------------
# M8 / M9 — Amazon Bedrock Settings (required if THREADBACK_AGENT_PROVIDER=bedrock)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID is fully configurable (ensure model access is enabled in your AWS account)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS credentials should be provided via ~/.aws/credentials or IAM role.
# NEVER commit real credentials to this file or repository!
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# M9 — Remote MCP, AgentCore Runtime & Authentication
# ---------------------------------------------------------------------------
AUTH_ENABLED=false                    # Set true to enforce Bearer token auth on /mcp
AUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_threadback
AUTH_AUDIENCE=threadback-mcp
# AUTH_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_threadback/.well-known/jwks.json
# AUTH_SECRET_KEY=                    # Used for HMAC token verification in test environments
# AGENTCORE_RUNTIME_ID=               # Amazon Bedrock AgentCore Runtime ID
# AGENTCORE_ENDPOINT_URL=             # Remote AgentCore endpoint URL
MCP_STATELESS=true

# ---------------------------------------------------------------------------
# M9 — Alexa+ Integration Settings
# ---------------------------------------------------------------------------
# ALEXA_SKILL_ID=                     # Alexa+ Add-on Skill ID
